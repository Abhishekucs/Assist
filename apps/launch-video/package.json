{
  "name": "assist-launch-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "soundtrack": "node scripts/compose-soundtrack.mjs",
    "prepare-media": "npm run assets && npm run soundtrack",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AssistLaunch out/assist-launch.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
