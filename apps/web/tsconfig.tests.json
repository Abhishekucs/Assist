{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "incremental": false,
    "plugins": []
  },
  "include": [
    "tests/**/*.ts",
    "app/fun/KeyboardAudio.ts",
    "app/fun/keyboard.ts",
    "app/lib/pricing.ts"
  ],
  "exclude": ["node_modules", ".test-build"]
}
